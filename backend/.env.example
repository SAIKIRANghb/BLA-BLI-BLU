# ---- Server ----
NODE_ENV=development
PORT=4000
# Comma separated list of allowed CORS origins (use * for development)
CORS_ORIGINS=*

# ---- PostgreSQL ----
DB_HOST=127.0.0.1
DB_PORT=5432
DB_NAME=blabliblu
DB_USER=postgres
DB_PASSWORD=postgresql
DB_POOL_MAX=10

# ---- Auth ----
JWT_SECRET=change-me-to-a-long-random-string
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=30d
BCRYPT_ROUNDS=10

# ---- Commerce ----
FREE_SHIPPING_THRESHOLD_Paise=39900
SHIPPING_FEE_PAISE=4900
# Repository adapter: "postgres" (default) or "memory" (seed-file, no DB needed)
REPOSITORY_DRIVER=postgres
